@model AccountLoginModel

@section Bar{
    <section class="bg-primary p-3">
        <div class="container">
            <nav>
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="/" class="text-primary text-decoration-none">Anasayfa</a>
                    </li>
                    <li class="breadcrumb-item">Kullanıcı Giriş</li>
                </ol>
            </nav>
        </div>
    </section>
}

<section mt-3>
    <div class="container mt-3">
        <div class="row justify-content-center">
            <div class="col-7">
                <div class="card card-body">
                    <form action="" method="post">
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control">
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control">
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="mb-3 form-check">
                            <input asp-for="BeniHatirla" class="form-check-label">
                            <label asp-for="BeniHatirla" class="form-check-label"></label>
                            <span asp-validation-for="BeniHatirla" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary">Giriş</button>
                        <a class="btn btn-warning" asp-controller="Account" asp-action="ForgotPassword">Parolamı
                            Unuttum</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>