@model Cart

@section Bar{
    <section class="bg-primary p-3">
        <div class="container">
            <nav>
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="/" class="text-primary text-decoration-none">Anasayfa</a>
                    </li>
                    <li class="breadcrumb-item">Sepetim</li>
                </ol>
            </nav>
        </div>
    </section>
}

<section class="mt-3">
    <div class="container">
        @if (Model.CartItems.Count == 0)
        {
            <div class="text-center">
                <p>Sepetinizde ürün bulunamadı</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Alışverişe Başla</a>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-lg-7">
                    <ul class="list-group">
                        @foreach (var item in Model.CartItems)
                        {
                            <li class="py-3 mb-2 border-top list-group-item">
                                <div class="row align-items-center">
                                    <div class="col-6">
                                        <div class="d-flex align-items-center">
                                            <img src="~/img/@item.Urun.Resim" style="width: 100px;" alt="">
                                            <div class="ms-3">
                                                <a class="text-decoration-none" href="#">
                                                    <h6 class="mb-0">@item.Urun.UrunAdi</h6>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-2">
                                        <form action="/Cart/UpdateQuantity" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="urunId" value="@item.UrunId">
                                            <input type="number" name="miktar" value="@item.Miktar" class="form-control" min="1" onchange="this.form.submit()">
                                        </form>
                                    </div>
                                    <div class="col-2 text-center">
                                        <span class="fw-bold">@item.Urun.fiyat.ToString("N2") ₺</span>
                                    </div>
                                    <div class="col-2 text-center">
                                        <form action="/Cart/RemoveItem" method="post">
                                            <input type="hidden" name="urunId" value="@item.UrunId">
                                            <input type="hidden" name="miktar" value="@item.Miktar">
                                            <button type="submit" class="btn btn-sm btn-danger"><i
                                                    class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
                <div class="col-lg-5">
                    <div class="card">
                        <div class="p-3 card-body">
                            <h2 class="h5 mb-4">Sipariş Özeti</h2>
                            <div class="card mb-2">
                                <div class="list-group list-group-flush">
                                    <div class="d-flex justify-content-center align-items-center list-group-item">
                                        <div class="me-auto">
                                            <div>Sipariş Toplamı</div>
                                        </div>
                                        <span>@Model.AraToplam().ToString("N2") ₺</span>
                                    </div>
                                    <div class="d-flex justify-content-center align-items-center list-group-item">
                                        <div class="me-auto">
                                            <div>Kargo Ücreti</div>
                                        </div>
                                        <span>Ücretsiz</span>
                                    </div>
                                    <div class="d-flex justify-content-center align-items-center list-group-item">
                                        <div class="me-auto">
                                            <div>Vergi (%20)</div>
                                        </div>
                                        <span>@((Model.AraToplam() * 0.2).ToString("N2")) ₺</span>
                                    </div>
                                    <div class="d-flex justify-content-center align-items-center list-group-item">
                                        <div class="me-auto">
                                            <div>Toplam</div>
                                        </div>
                                        <span>@Model.Toplam().ToString("N2") ₺</span>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between">
                                <a asp-controller="Home" asp-action="Index"
                                    class="btn btn-outline-primary btn-lg mt-3">Alışverişe
                                    Devam Et</a>
                                <a asp-controller="Order" asp-action="Checkout" class="btn btn-danger btn-lg mt-3">Siparişi
                                    Tamamla</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>
</section>