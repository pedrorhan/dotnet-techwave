@model List<Order>

@section Bar{
    <section class="bg-primary p-3">
        <div class="container">
            <nav>
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="/" class="text-primary text-decoration-none">Anasayfa</a>
                    </li>
                    <li class="breadcrumb-item">Siparişler</li>
                </ol>
            </nav>
        </div>
    </section>
}

<section class="mt-3">
    <div class="container">
        <div class="row">
            <div class="col-md-3">
                @await Html.PartialAsync("Partials/Site/_AccountSiderBar")
            </div>
            <div class="col-md-9">
                <div class="card-shadow">
                    <div class="card-header py-1">
                        <h5 class="card-title mb-0"></h5>
                    </div>
                    <div class="card-body">
                        @if (Model.Count == 0)
                        {
                            <div class="alert alert-info">Sipariş bulunamadı.</div>
                        }
                        else
                        {
                            <div class="accordion" id="orders">
                                @foreach (var order in Model)
                                {
                                    <div class="accordion-item">
                                        <h2 class="accordion-header">
                                            <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                                data-bs-target="#order_@order.Id">
                                                Sipariş No: #@order.Id
                                            </button>
                                        </h2>
                                        <div id="order_@order.Id" class="accordion-collapse collapse p-3"
                                            data-bs-parent="#orders">
                                            <table class="table table-bordered mb-0">
                                                <tr>
                                                    <td colspan="2">
                                                        Teslim Tarihi
                                                    </td>
                                                    <td colspan="3">
                                                        @order.SiparisTarihi.ToString("dd/MM/yyyy")
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td colspan="2">
                                                        Ad Soyad
                                                    </td>
                                                    <td colspan="3">
                                                        @order.AdSoyad
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td colspan="2">
                                                        Adres
                                                    </td>
                                                    <td colspan="3">
                                                        @order.AdresSatiri,
                                                        @order.Sehir,
                                                        @order.PostaKodu
                                                    </td>
                                                </tr>
                                                @foreach (var item in order.OrderItems)
                                                {
                                                    <tr>
                                                        <td style="width: 80px;">
                                                            <img src="~/img/@item.Urun.Resim" class="img-fluid" alt="">
                                                        </td>
                                                        <td>
                                                            @item.Urun.UrunAdi
                                                        </td>
                                                        <td>
                                                            @item.Fiyat.ToString("N2") ₺
                                                        </td>
                                                        <td>
                                                            @item.Miktar
                                                            <span>adet</span>
                                                        </td>
                                                        <td>
                                                            @((item.Fiyat * item.Miktar).ToString("N2")) ₺
                                                        </td>
                                                    </tr>
                                                }
                                                <tr>
                                                    <td colspan="3"></td>
                                                    <td>Ara Toplam</td>
                                                    <td>@order.AraToplam().ToString("N2") ₺</td>
                                                </tr>
                                                <tr>
                                                    <td colspan="3"></td>
                                                    <td>Toplam</td>
                                                    <td>@order.Toplam().ToString("N2") ₺</td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>