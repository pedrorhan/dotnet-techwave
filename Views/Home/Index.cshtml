@model List<Urun>

@{
ViewData["Title"] = "Home Page";
}

@section Bar{
    @await Component.InvokeAsync("Navbar")
}

<section class="mt-2">
    <div class="container">
        <!-- slider -->
        <div class="mb-4">
            @await Component.InvokeAsync("Slider")
        </div>
    </div>
</section>

<section class="mt-4 mb-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="h4 mb-0 fw-bold">En Yeni Ürünler</h3>
            <a href="/urunler" class="text-primary text-decoration-none fw-bold">Tümünü Gör <i class="fa fa-arrow-right ms-1"></i></a>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach(var urun in Model){
                <div class="col">
                    @await Html.PartialAsync("Partials/Site/_UrunCard",urun)
                </div>
            }
        </div>
    </div>
</section>
